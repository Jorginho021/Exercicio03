package exercicio.pkg7;

import java.util.ArrayList;


public class Usuario {
     private String nome;
    private ArrayList<Emprestimo> emprestimos;

    public Usuario(String nome) {
        this.nome = nome;
        this.emprestimos = new ArrayList<>();
    }

    // Getters e Setters
    public String getNome() {
        return nome;
    }

    public void setNome(String nome) {
        this.nome = nome;
    }

    public ArrayList<Emprestimo> getEmprestimos() {
        return emprestimos;
    }

    // Realizar empréstimo
    public void pegarLivro(Livro livro, int dias) {
        if (livro.emprestar()) {
            Emprestimo emprestimo = new Emprestimo(this, livro, dias);
            emprestimos.add(emprestimo);
            System.out.println(nome + " pegou o livro '" + livro.getTitulo() + "' por " + dias + " dias.");
        }
    }

    // Devolver livro
    public void devolverLivro(Livro livro) {
        for (Emprestimo e : emprestimos) {
            if (e.getLivro() == livro) {
                double multa = e.calcularMulta();
                livro.devolver();
                emprestimos.remove(e);
                System.out.println(nome + " devolveu o livro '" + livro.getTitulo() + "'. Multa: R$" + multa);
                return;
            }
        }
        System.out.println(nome + " não possui empréstimo desse livro.");
    }

    @Override
    public String toString() {
        return "Usuário: " + nome + " | Empréstimos ativos: " + emprestimos.size();
    }
}

