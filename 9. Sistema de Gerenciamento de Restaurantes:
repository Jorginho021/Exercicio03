package exercicio9;

import java.time.LocalDateTime;


public class Exercicio9 {

   
    public static void main(String[] args) {
          
        // Criando pratos
        Prato p1 = new Prato("Pizza Margherita", 35.0);
        Prato p2 = new Prato("Lasagna", 40.0);
        Prato p3 = new Prato("Salada Caesar", 25.0);

        // Criando mesas
        Mesa m1 = new Mesa(1);
        Mesa m2 = new Mesa(2);

        // Reservando mesas
        m1.reservar(LocalDateTime.of(2025, 9, 5, 19, 0));
        m2.reservar(LocalDateTime.of(2025, 9, 6, 20, 30));

        // Criando pedidos
        Pedido pedido1 = m1.criarPedido();
        pedido1.adicionarPrato(p1);
        pedido1.adicionarPrato(p3);

        Pedido pedido2 = m2.criarPedido();
        pedido2.adicionarPrato(p2);
        pedido2.adicionarPrato(p2);
        pedido2.adicionarPrato(p3);

        // Calcular total dos pedidos
        System.out.println("\n=== Total dos Pedidos ===");
        System.out.println(pedido1);
        System.out.println(pedido2);

        // Exibir reservas futuras
        System.out.println("\n=== Reservas Futuras ===");
        m1.exibirReserva();
        m2.exibirReserva();

        // Exibir mesas e pedidos
        System.out.println("\n=== Mesas e Pedidos ===");
        System.out.println(m1);
        System.out.println(m2);
    }
}
